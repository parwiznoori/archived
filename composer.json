{
    "name": "archive/government-archive",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-imagick": "*",
        "carlos-meneses/laravel-mpdf": "^2.1.13",
        "intervention/image": "^3.11",
        "laravel/framework": "^13.0",
        "laravel/helpers": "^1.8",
        "laravel/passport": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.3",
        "maatwebsite/excel": "^4.0",
        "morilog/jalali": "^3.5",
        "prabowosd/laravel-collective-html": "^1.2",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.4",
        "spatie/laravel-permission": "^8.5",
        "yadahan/laravel-authentication-log": "^1.9",
        "yajra/laravel-datatables-buttons": "^13.0",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories",
            "packages/sallar/jdatetime/jdatetime.class.php"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Http/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
